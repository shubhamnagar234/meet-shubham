# Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (e.g. gemini-3.5-flash, gemini-3-flash-preview, gemini-3.5-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: Second provider fallback for open-ended questions when Gemini quota is exhausted
# (Not required - the application automatically uses the local verified fallback bank if unset)
# OPENAI_API_KEY=your_openai_api_key_here
# SECOND_PROVIDER_MODEL=gpt-4o-mini

# Neural TTS voice (defaults to en-IN-PrabhatNeural for authentic Indian English voice)
TTS_VOICE=en-IN-PrabhatNeural
